# Root environment variables for local development and Docker Compose
APP_NAME="Restaurant AI Agent"
APP_ENV=development
DEBUG=True

# Backend
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_secure_password
POSTGRES_DB=restaurant_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_secure_password@localhost:5432/restaurant_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
